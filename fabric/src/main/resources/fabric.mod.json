{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_display_name}",
  "description": "Native server administration for Minecraft Java Edition: permissions, moderation, teleportation, player utilities, audit logging, and an admin GUI that works on unmodified vanilla clients.",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "contact": {
    "homepage": "https://mwtstudios.net",
    "sources": "https://github.com/Modzwastaken/NexusCore-Mod-NCM",
    "issues": "https://github.com/Modzwastaken/NexusCore-Mod-NCM/issues",
    "email": "mwt@mwtstudios.net"
  },
  "icon": "nexuscore.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.mwtstudios.nexuscore.fabric.NexusCoreFabric"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
